{
  "name": "helpdesk",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "bun --filter server --filter client dev",
    "dev:server": "bun --filter server dev",
    "dev:client": "bun --filter client dev",
    "build": "bun --filter client build",
    "start": "bun --filter server start",
    "test": "bun --filter server --filter client test",
    "test:e2e": "bun --filter e2e test",
    "typecheck": "bun --filter '*' typecheck"
  }
}
