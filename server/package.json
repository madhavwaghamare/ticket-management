{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "bun --env-file=.env --bun prisma generate",
    "db:generate": "bun --env-file=.env --bun prisma generate",
    "db:migrate": "bun --env-file=.env --bun prisma migrate dev",
    "db:studio": "bun --env-file=.env --bun prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "core": "workspace:*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
